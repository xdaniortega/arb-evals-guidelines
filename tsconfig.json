{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "cases/*/validator*.ts",
    "cases/*/prepare.ts",
    "cases/*/prepare.test.ts",
    "cases/*/oracle-aux.ts",
    "cases/*/oracle-aux.test.ts",
    "cases/*/preparation-fixtures.ts"
  ]
}
