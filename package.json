{
  "name": "arb-evals",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "description": "Isolated paired evals for agent skills (evals-example).",
  "repository": {
    "type": "git",
    "url": "https://github.com/xdaniortega/evals-example"
  },
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run && pnpm test:eval-cases",
    "test:evals": "vitest run src",
    "test:eval-sdk": "vitest run src/harnesses/pi/sdk-session.test.ts src/harnesses/pi/supervisor-agent.test.ts",
    "build:eval-guest": "node scripts/build-guest-runtime.mjs",
    "test:eval-cases": "node --import ./scripts/case-test-resolver.mjs --test \"eval-cases/*/validator.test.ts\" \"eval-cases/*/oracle-aux.test.ts\" \"eval-cases/*/prepare.test.ts\"",
    "test:container": "EVAL_CONTAINER_TESTS=1 vitest run --maxWorkers=1 src/sandboxes/apple-container.test.ts src/runner/container-validator.test.ts src/runner/container-paired.test.ts src/sandboxes/laptop-isolation.test.ts",
    "eval": "node --experimental-strip-types scripts/run.ts",
    "eval:validate": "node --experimental-strip-types scripts/validate.ts",
    "eval:report": "node --experimental-strip-types scripts/report.ts",
    "eval:export": "node --experimental-strip-types scripts/export.ts",
    "eval:history": "node --experimental-strip-types scripts/history.ts",
    "eval:inspect": "node --experimental-strip-types scripts/inspect.ts",
    "eval:recover": "node --experimental-strip-types scripts/doctor.ts",
    "eval:doctor": "node --experimental-strip-types scripts/doctor.ts --doctor",
    "typecheck": "pnpm typecheck:evals",
    "typecheck:evals": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@types/node": "^22.15.0",
    "ajv": "^8.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
